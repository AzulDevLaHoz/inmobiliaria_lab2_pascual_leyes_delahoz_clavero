@model IEnumerable<inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Reserva>
@{
    ViewData["Title"] = "Pagos";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string estadoSeleccionado = ViewBag.EstadoSeleccionado as string ?? "Todos";
}
<h1>Pagos</h1>
<div class="d-flex justify-content-between align-items-end mt-3 flex-wrap gap-2">
    <form method="get" asp-action="Index" class="mb-0">
        <label class="form-label mb-1">Estado</label>
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="Todos" selected="@(estadoSeleccionado == "Todos" ? "selected" : null)">Todos</option>
            <option value="EnCurso" selected="@(estadoSeleccionado == "EnCurso" ? "selected" : null)">En Curso</option>
            <option value="Finalizada" selected="@(estadoSeleccionado == "Finalizada" ? "selected" : null)">Finalizada</option>
            <option value="AdeudaPago" selected="@(estadoSeleccionado == "AdeudaPago" ? "selected" : null)">Adeuda Pago</option>
        </select>
    </form>
    <a asp-action="Buscar" class="btn btn-secondary">
        <i class="bi bi-search"></i> Buscar Pago
    </a>
</div>

@if (!Model.Any())
{
    <p class="mt-3">No hay reservas con pagos registrados para este estado.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Fecha de Reserva</th>
                <th>Monto Total Abonado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Inquilino?.ToString()</td>
                    <td>@item.FechaEntrada.ToShortDateString()</td>
                    <td>@FormatoAr.Moneda(item.MontoTotalAbonado ?? 0m)</td>
                    <td>
                        <a asp-action="DetalleReserva" asp-route-idReserva="@item.IdReserva" class="btn btn-info btn-sm">
                            <i class="bi bi-list-ul"></i> Detalles de pago
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (totalPaginas > 1)
{
    <nav aria-label="Paginación de Pagos" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-estado="@estadoSeleccionado">Anterior</a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@estadoSeleccionado">@i</a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-estado="@estadoSeleccionado">Siguiente</a>
            </li>
        </ul>
    </nav>
}