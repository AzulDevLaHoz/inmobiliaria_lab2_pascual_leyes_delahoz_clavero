@model inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Inmueble
@using inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models
@{
    ViewData["Title"] = "Detalles del Inmueble";
    var propietario = (Propietario?)ViewBag.Propietario;
    var tipoInmueble = (TipoInmueble?)ViewBag.TipoInmueble;
}

<h1>Detalles del Inmueble</h1>
<hr />

<div id="app" class="row">

    <div class="col-md-5 mb-4">
        <div class="card shadow-sm">
            <div class="position-relative">
                <img src="@(string.IsNullOrEmpty(Model.StringPortada) ? "/Uploads/sinImagen.png" : Model.StringPortada)"
                     class="card-img-top" style="height: 250px; object-fit: cover;" alt="Portada del Inmueble">

                <form asp-controller="Inmueble" asp-action="CambiarPortada" method="post" enctype="multipart/form-data"
                      id="formCambiarPortada">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <input type="file" name="ImagenPortada" id="inputPortada" style="display: none;" accept="image/*"
                           onchange="document.getElementById('formCambiarPortada').submit();" />

                    <button type="button" class="btn btn-sm btn-dark position-absolute bottom-0 end-0 m-2 opacity-75"
                            onclick="document.getElementById('inputPortada').click();">
                        <i class="bi bi-camera"></i> Cambiar Portada
                    </button>
                </form>
            </div>

            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Información del Inmueble</h5>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Dirección:</dt>
                    <dd class="col-sm-7">@Model.Direccion</dd>

                    <dt class="col-sm-5">Tipo:</dt>
                    <dd class="col-sm-7">@tipoInmueble?.Nombre</dd>

                    <dt class="col-sm-5">Propietario:</dt>
                    <dd class="col-sm-7">@propietario?.ToString()</dd>

                    <dt class="col-sm-5">Capacidad:</dt>
                    <dd class="col-sm-7">@Model.Capacidad personas</dd>

                    <dt class="col-sm-5">Monto x Día:</dt>
                    <dd class="col-sm-7">$@Model.montoDia</dd>

                    <dt class="col-sm-5">% Reserva:</dt>
                    <dd class="col-sm-7">@Model.porcentajeReserva %</dd>

                    <dt class="col-sm-5">Coordenadas:</dt>
                    <dd class="col-sm-7"><small>@Model.Latitud, @Model.Longitud</small></dd>

                    <dt class="col-sm-5">Estado:</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.Estado ? "bg-success" : "bg-danger")">
                            @(Model.Estado ? "Activo" : "Inactivo")
                        </span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Volver a la lista</a>
            </div>
        </div>
    </div>

    <div class="col-md-7">

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <form asp-controller="Imagen" asp-action="AgregarImagen" method="post" enctype="multipart/form-data"
                  id="formAgregarImagenes" class="d-flex align-items-center gap-2">
                <input type="hidden" name="IdInmueble" value="@Model.Id" />

                <input type="file" name="Archivos" id="inputArchivos" style="display: none;" accept="image/*" multiple
                @@change="onFilesChange" />

                <button type="button" class="btn btn-primary"
                        onclick="document.getElementById('inputArchivos').click();">
                    <i class="bi bi-plus-circle"></i> Agregar imágenes
                </button>

                <button v-if="previews.length" type="submit" class="btn btn-success">
                    <i class="bi bi-upload"></i> Subir ({{ previews.length }})
                </button>
            </form>

            <div class="btn-group" role="group">
                <button type="button" class="btn"
                        :class="vistaActiva === 'galeria' ? 'btn-primary' : 'btn-outline-primary'"
                    @@click="vistaActiva = 'galeria'">
                    <i class="bi bi-images"></i> Galería
                </button>
                <button type="button" class="btn"
                        :class="vistaActiva === 'historial' ? 'btn-primary' : 'btn-outline-primary'"
                    @@click="mostrarHistorial">
                    <i class="bi bi-clock-history"></i> Historial de Reservas
                </button>
            </div>
        </div>

        <div v-if="previews.length" class="d-flex flex-wrap gap-2 mb-3">
            <img v-for="(src, idx) in previews" :key="idx" :src="src" class="img-thumbnail" style="max-height: 80px;"
                 alt="Vista previa">
        </div>

        <div v-if="vistaActiva === 'galeria'">
            <h3 class="mb-3">Galería de Fotos ({{ imagenes.length }})</h3>

            <div v-if="imagenes.length === 0" class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i> Este inmueble no tiene imágenes adicionales asociadas.
            </div>

            <div v-else class="row row-cols-1 row-cols-sm-2 g-3">
                <div class="col" v-for="img in imagenes" :key="img.IdImagen">
                    <div class="card h-100 shadow-sm position-relative">
                        <img :src="img.ImagenString || '/Uploads/sinImagen.png'" class="card-img-top"
                             style="height: 180px; object-fit: cover; cursor: zoom-in;" alt="Foto inmueble"
                        @@click="ampliarImagen(img.ImagenString)">

                        <form asp-controller="Imagen" asp-action="EliminarImagen" method="post"
                              class="position-absolute top-0 end-0 m-1" :id="`form-eliminar-${img.IdImagen}`">
                            <input type="hidden" name="id" :value="img.IdImagen" />
                            <input type="hidden" name="idInmueble" value="@Model.Id" />
                            <button type="button" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Eliminar"
                                @@click="imagenAEliminar = img">
                                <i class="bi bi-x-lg text-danger"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div v-if="vistaActiva === 'historial'">
            <h3 class="mb-3">Historial de Reservas</h3>

            <div v-if="cargandoHistorial" class="text-center text-muted py-4">
                <div class="spinner-border spinner-border-sm me-2"></div> Cargando historial...
            </div>

            <div v-else-if="reservas.length === 0" class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i> Este inmueble todavía no tiene reservas registradas.
            </div>

            <table v-else class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Inquilino</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Multa</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="r in reservas" :key="r.id">
                        <td>{{ r.fechaEntrada }}</td>
                        <td>{{ r.fechaSalida }}</td>
                        <td>{{ r.inquilino }}</td>
                        <td>
                            <span class="badge" :class="r.estado ? 'bg-success' : 'bg-secondary'">
                                {{ r.estado ? 'Activa' : 'Inactiva' }}
                            </span>
                        </td>
                        <td>${{ r.montoTotal.toLocaleString('es-AR') }}</td>
                        <td>{{ r.multa != null ? '$' + r.multa : '-' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div v-if="imagenAmpliada" class="overlay-base overlay-oscuro" @@click.self="imagenAmpliada = null">
        <button class="btn btn-light rounded-circle lightbox-cerrar" @@click="imagenAmpliada = null">
            <i class="bi bi-x-lg"></i>
        </button>
        <img :src="imagenAmpliada" class="lightbox-imagen" alt="Imagen ampliada">
    </div>

    <div v-if="imagenAEliminar" class="overlay-base overlay-claro" @@click.self="imagenAEliminar = null">
        <div class="confirm-box">
            <div class="confirm-header">
                <h5 class="mb-0">Confirmar eliminación</h5>
                <button type="button" class="btn-close" @@click="imagenAEliminar = null"></button>
            </div>
            <div class="confirm-body">
                ¿Estás seguro que deseás eliminar esta imagen? Esta acción no se puede deshacer.
            </div>
            <div class="confirm-footer">
                <button type="button" class="btn btn-secondary" @@click="imagenAEliminar = null">Cancelar</button>
                <button type="button" class="btn btn-danger" @@click="confirmarEliminarImagen">
                    <i class="bi bi-trash3"></i> Sí, Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const { createApp, ref } = Vue;

        createApp({
        setup() {
        const imagenes = ref(@Html.Raw(ViewBag.ImagenesJson ?? "[]"));
        const previews = ref([]);
        const imagenAmpliada = ref(null);

        const vistaActiva = ref('galeria');
        const reservas = ref([]);
        const historialCargado = ref(false);
        const cargandoHistorial = ref(false);
        const imagenAEliminar = ref(null);

        function confirmarEliminarImagen() {
        if (!imagenAEliminar.value) return;
        document.getElementById(`form-eliminar-${imagenAEliminar.value.IdImagen}`).submit();
        }

        function onFilesChange(event) {
        const archivos = Array.from(event.target.files);
        previews.value = archivos.map(archivo => URL.createObjectURL(archivo));
        }

        function ampliarImagen(src) {
        imagenAmpliada.value = src;
        }

        async function mostrarHistorial() {
        vistaActiva.value = 'historial';
        if (historialCargado.value) return;

        cargandoHistorial.value = true;
        try {
        const respuesta = await fetch(`/Reserva/HistorialJson/@Model.Id`);
        if (!respuesta.ok) throw new Error('No se pudo cargar el historial.');
        reservas.value = await respuesta.json();
        historialCargado.value = true;
        } catch (e) {
        console.error(e);
        } finally {
        cargandoHistorial.value = false;
        }
        }

        return {
        imagenes, previews, imagenAmpliada,
        onFilesChange, ampliarImagen,
        vistaActiva, reservas, cargandoHistorial, mostrarHistorial,
        imagenAEliminar, confirmarEliminarImagen,
        };
        }
        }).mount('#app');
    </script>
}