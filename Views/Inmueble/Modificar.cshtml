@model inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Inmueble
@using inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models
@{
    ViewData["Title"] = "Modificar Inmueble";

    var p = (Propietario)ViewBag.Propietario;
    var ltaTipoInmuebles = (IList<TipoInmueble>)ViewBag.TipoInmuebles;
}

<h1>Modificar</h1>

<h4>Inmueble</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Modificar" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacidad" class="control-label"></label>
                <input asp-for="Capacidad" class="form-control" type="number" />
                <span asp-validation-for="Capacidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="montoDia" class="control-label"></label>
                <input asp-for="montoDia" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="montoDia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="porcentajeReserva" class="control-label"></label>
                <input asp-for="porcentajeReserva" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="porcentajeReserva" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Latitud" class="control-label"></label>
                <input asp-for="Latitud" class="form-control" />
                <span asp-validation-for="Latitud" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Longitud" class="control-label"></label>
                <input asp-for="Longitud" class="form-control" />
                <span asp-validation-for="Longitud" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenPortada" class="control-label"></label>
                <input asp-for="ImagenPortada" class="form-control" type="file" />
                <span asp-validation-for="ImagenPortada" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoInmuebleId" class="control-label">Tipo de Inmueble</label>
                <select asp-for="TipoInmuebleId" class="form-select">
                    <option value="">Seleccionar Tipo</option>
                    @if (ltaTipoInmuebles != null)
                    {
                        foreach (var item in ltaTipoInmuebles)
                        {
                            <option value="@item.IdTipoInmueble">@item.ToString()</option>
                        }
                    }
                </select>
                <span asp-validation-for="TipoInmuebleId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PropietarioId" class="control-label">Propietario</label>
                <select asp-for="PropietarioId" id="selectPropietario" class="form-select select2-ajax"
                        data-url="/Propietario/Buscar"
                        data-placeholder="Escriba para buscar propietario... (Nombre, Apellido o DNI)">
                    @if (Model != null && Model.PropietarioId > 0)
                    {
                        <option value="@Model.PropietarioId" selected>@p.ToString()</option>
                    }
                </select>
                <span asp-validation-for="PropietarioId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/buscarTexto.js" asp-append-version="true"></script>
}