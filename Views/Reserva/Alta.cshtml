@model inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Reserva

@{
    ViewData["Title"] = "Alta de Reserva";

    var listaInmuebles = (IList<Inmueble>)ViewBag.Inmuebles;
}

<h1>Alta de Reserva</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Alta" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div id="app-disponibilidad">
                <div class="mb-3">
                    <label asp-for="FechaEntrada" class="form-label"></label>
                    @if (ViewBag.EsExtension == true)
                    {
                        <input asp-for="FechaEntrada" class="form-control bg-light" type="date"
                               value="@(Model?.FechaEntrada != DateTime.MinValue ? Model?.FechaEntrada.ToString("yyyy-MM-dd") : "")"
                               readonly />
                    }
                    else
                    {
                        <input asp-for="FechaEntrada" class="form-control" type="date"
                               value="@(Model?.FechaEntrada != DateTime.MinValue ? Model?.FechaEntrada.ToString("yyyy-MM-dd") : "")" />
                    }
                    <span asp-validation-for="FechaEntrada" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaSalida" class="form-label"></label>
                    <input asp-for="FechaSalida" class="form-control" type="date" v-model="fechaSalida"
                           value="@(Model?.FechaSalida != DateTime.MinValue ? Model?.FechaSalida.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="FechaSalida" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdInquilino" class="control-label"></label>
                    @if (ViewBag.EsExtension == true)
                    {
                        <input type="hidden" asp-for="IdInquilino" />
                        <input type="text" class="form-control bg-light"
                               value="@ViewBag.InquilinoPreseleccionado?.Nombre @ViewBag.InquilinoPreseleccionado?.Apellido"
                               readonly />
                    }
                    else
                    {
                        <select asp-for="IdInquilino" id="selectInquilino" class="form-select select2-ajax"
                                data-url="/Inquilino/Buscar"
                                data-placeholder="Escriba para buscar inquilino... (Nombre, Apellido o DNI)">
                        </select>
                    }
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdInmueble" class="form-label">Inmueble</label>
                    @if (ViewBag.EsExtension == true)
                    {
                        <input type="hidden" asp-for="IdInmueble" />
                        <input type="text" class="form-control bg-light" value="@ViewBag.InmueblePreseleccionado?.Direccion"
                               readonly />
                    }
                    else
                    {
                        <select asp-for="IdInmueble" id="selectInmueble" class="form-select select2-ajax"
                                data-url="/Inmueble/BuscarPorTextoAjax"
                                data-placeholder="Escriba para buscar inmueble por dirección...">
                        </select>
                    }
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>

                <div v-cloak v-if="verificando" class="form-text">Verificando disponibilidad...</div>
                <div v-cloak v-if="disponible === false" class="alert alert-warning py-2">Este inmueble ya tiene una
                    reserva
                    activa en esas fechas.</div>
                    <div v-cloak v-if="disponible === true" class="text-success">✓ Disponible</div>
                </div>

                <div class="mt-4">
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/buscarTexto.js" asp-append-version="true"></script>
        <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
        <script src="~/js/reservaDisponibilidad.js" asp-append-version="true"></script>
    }