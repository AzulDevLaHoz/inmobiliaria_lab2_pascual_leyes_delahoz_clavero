@model IEnumerable<inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Reserva>
@{
    ViewData["Title"] = "Reservas";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string estadoSeleccionado = ViewBag.EstadoSeleccionado as string ?? "Todos";
}
<h1>Reservas</h1>
<div class="d-flex justify-content-between align-items-end mt-3 flex-wrap gap-2">
    <form method="get" asp-action="Index" class="mb-0">
        <label class="form-label mb-1">Estado</label>
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="Todos" selected="@(estadoSeleccionado == "Todos" ? "selected" : null)">Todos</option>
            <option value="EnCurso" selected="@(estadoSeleccionado == "EnCurso" ? "selected" : null)">En Curso</option>
            <option value="Finalizada" selected="@(estadoSeleccionado == "Finalizada" ? "selected" : null)">Finalizada
            </option>
            <option value="AdeudaPago" selected="@(estadoSeleccionado == "AdeudaPago" ? "selected" : null)">Adeuda Pago
            </option>
        </select>
    </form>
    <div>
        <a asp-action="Alta" class="btn btn-primary">Crear Nueva Reserva</a>
        <a asp-controller="Inmueble" asp-action="Buscar" class="btn btn-secondary">
            <i class="bi bi-search"></i> Buscar Inmuebles
        </a>
    </div>
</div>
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.IdReserva)</th>
            <th>@Html.DisplayNameFor(model => model.FechaEntrada)</th>
            <th>@Html.DisplayNameFor(model => model.FechaSalida)</th>
            <th>Estado</th>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var reservasConSenia = ViewBag.ReservasConSenia as HashSet<int> ?? new HashSet<int>();
            var reservasConPago = ViewBag.ReservasConPago as HashSet<int> ?? new HashSet<int>();
            var reservasConMultaPagada = ViewBag.ReservasConMultaPagada as HashSet<int> ?? new HashSet<int>();

            bool finalizada = (item.FechaMulta == null && reservasConPago.Contains(item.IdReserva))
                            || (item.FechaMulta != null && reservasConMultaPagada.Contains(item.IdReserva));
            string etiquetaEstado = finalizada
                ? "Finalizada"
                : (item.FechaSalida.Date < DateTime.Today ? "Adeuda Pago" : "En Curso");

            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdReserva)</td>
                <td>@item.FechaEntrada.ToShortDateString()</td>
                <td>@item.FechaSalida.ToShortDateString()</td>
                <td>@etiquetaEstado</td>
                <td>@item.Inquilino?.ToString()</td>
                <td>@item.Inmueble?.Direccion</td>
                <td>
                    <div class="btn-group" role="group">
                        @if (!finalizada)
                        {
                            <a asp-action="Modificar" title="Editar" asp-route-id="@item.IdReserva"
                               class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Alta" asp-route-idInmueble="@item.IdInmueble"
                               asp-route-idInquilino="@item.IdInquilino"
                               asp-route-fechaEntrada="@item.FechaSalida.ToString("yyyy-MM-dd")" title="Extender Reserva"
                               class="btn btn-success btn-sm">
                                <i class="bi bi-plus-circle"></i> Extender
                            </a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <button title="Eliminar" type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar-@item.IdReserva">
                                <i class="bi bi-trash3"></i>
                            </button>
                        }
                        @if (!reservasConSenia.Contains(item.IdReserva))
                        {
                            <a asp-controller="Pago" asp-action="Alta" asp-route-idReserva="@item.IdReserva"
                               asp-route-tipo="Seña" title="Pagar Seña" class="btn btn-primary btn-sm">
                                <i class="bi bi-piggy-bank"></i> Pagar Seña
                            </a>
                        }
                        else if (item.FechaMulta != null && item.Multa.GetValueOrDefault() > 0)
                        {
                            if (reservasConMultaPagada.Contains(item.IdReserva))
                            {
                                <a class="btn btn-success btn-sm disabled" aria-disabled="true" tabindex="-1"
                                   title="Multa ya cobrada">
                                    <i class="bi bi-check-circle"></i> Multa Cobrada
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Pago" asp-action="Alta" asp-route-idReserva="@item.IdReserva"
                                   asp-route-tipo="Multa" title="Cobrar multa por salida anticipada" class="btn btn-danger btn-sm">
                                    <i class="bi bi-cash-coin"></i> Pagar Multa
                                </a>
                            }
                        }
                        else if (item.FechaMulta != null)
                        {
                            <a class="btn btn-secondary btn-sm disabled" aria-disabled="true" tabindex="-1"
                               title="Salida anticipada sin multa a cobrar">
                                <i class="bi bi-check-circle"></i> Cerrada
                            </a>
                        }
                        else if (reservasConPago.Contains(item.IdReserva))
                        {
                            <a class="btn btn-success btn-sm disabled" aria-disabled="true" tabindex="-1"
                               title="Hospedaje ya pagado">
                                <i class="bi bi-check-circle"></i> Hospedaje Pagado
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Pago" asp-action="Alta" asp-route-idReserva="@item.IdReserva"
                               asp-route-tipo="Completo" title="Pagar Hospedaje" class="btn btn-success btn-sm">
                                <i class="bi bi-cash-coin"></i> Pagar Hospedaje
                            </a>
                            <a asp-action="SalidaAnticipada" asp-route-id="@item.IdReserva" title="Salida Anticipada"
                               class="btn btn-warning btn-sm">
                                <i class="bi bi-door-open"></i> Salida Anticipada
                            </a>
                        }
                    </div>
                </td>
            </tr>

            <div class="modal fade" id="modalEliminar-@item.IdReserva" tabindex="-1"
                 aria-labelledby="modalLabel-@item.IdReserva" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalLabel-@item.IdReserva">Confirmar Baja</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            ¿Estás seguro que deseás eliminar la reserva?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <form asp-action="Eliminar" asp-route-id="@item.IdReserva" method="post">
                                <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

@if (totalPaginas > 1)
{
    <nav aria-label="Paginación de Reservas" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                   asp-route-estado="@estadoSeleccionado">Anterior</a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@estadoSeleccionado">@i</a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                   asp-route-estado="@estadoSeleccionado">Siguiente</a>
            </li>
        </ul>
    </nav>
}