@model IEnumerable<inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<h1>Propietarios</h1>

<div class="text-end mt-3">
    <a asp-action="Alta" class="btn btn-primary">Crear Nuevo Propietario</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdPropietario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdPropietario)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dni)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telefono)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    <a asp-action="Modificar" asp-route-id="@item.IdPropietario" class="btn btn-primary btn-sm">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@item.IdPropietario" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar este propietario?');">Eliminar</button>
                    </form>
                    <a asp-action="PorPropietario" asp-controller="Inmuebles" asp-route-id="@item.IdPropietario"
                    class="btn btn-success btn-sm">Mis Propiedades</a>
                </td>
            </tr>
        }
    </tbody>
</table>