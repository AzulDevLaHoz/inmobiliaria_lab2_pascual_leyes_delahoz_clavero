@model IEnumerable<inmobiliaria_lab2_pascual_leyes_delahoz_clavero.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<h1>Propietarios</h1>

<div class="text-end mt-3">
    <a asp-action="Alta" class="btn btn-primary">Crear Nuevo Propietario</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdPropietario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdPropietario)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dni)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telefono)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Modificar" title="Editar" asp-route-id="@item.IdPropietario"
                            class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i></a>
                        <button title="Eliminar" type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                data-bs-target="#modalEliminar-@item.IdPropietario">
                            <i class="bi bi-trash3"></i>
                        </button>
                        <a asp-action="PorPropietario" asp-controller="Inmuebles" asp-route-id="@item.IdPropietario"
                            class="btn btn-success btn-sm" title="Mis Propiedades"><i class="bi bi-buildings"></i></a>
                    </div>
                </td>
            </tr>

            <div class="modal fade" id="modalEliminar-@item.IdPropietario" tabindex="-1"
                 aria-labelledby="modalLabel-@item.IdPropietario" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalLabel-@item.IdPropietario">Confirmar Baja</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            ¿Estás seguro que deseás dar de baja al propietario <strong>@item.Nombre
                            @item.Apellido</strong>?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <form asp-action="Eliminar" asp-route-id="@item.IdPropietario" method="post">
                                <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>